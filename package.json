{
  "name": "vivah",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready Next.js (App Router) template for Google Cloud Run.",
  "license": "MIT",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:emulator": "./scripts/run-emulator-tests.sh",
    "test:e2e": "playwright test",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage",
    "docker:build": "./scripts/docker-build.sh",
    "docker:run": "./scripts/docker-run.sh",
    "rename": "./scripts/rename-project.sh",
    "db:emulator": "gcloud emulators firestore start --host-port=127.0.0.1:8085 --database-mode=firestore-native",
    "db:deploy": "./scripts/firestore-deploy.sh",
    "gcp:teardown": "./scripts/gcp-teardown.sh",
    "clean": "rm -rf .next coverage node_modules playwright-report test-results"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "@google-cloud/storage": "^8.4.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
